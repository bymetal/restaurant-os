{
  "name": "restaurant-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -b --pretty false && pnpm run build:web",
    "build:api": "tsc -b --pretty false",
    "build:web": "pnpm --filter @restaurant-os/admin build && pnpm --filter @restaurant-os/storefront build",
    "typecheck": "tsc -b --pretty false && pnpm run typecheck:web",
    "typecheck:web": "pnpm --filter @restaurant-os/admin run typecheck && pnpm --filter @restaurant-os/storefront run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "pnpm run build:api && pnpm --filter @restaurant-os/db migrate",
    "db:seed": "pnpm run build:api && pnpm --filter @restaurant-os/db seed",
    "dev": "pnpm run build:api && cross-env PORT=4000 pnpm --parallel --filter @restaurant-os/api --filter @restaurant-os/worker dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "cross-env": "^7.0.3",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "playwright": "^1.49.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.5"
  }
}
