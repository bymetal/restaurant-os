NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
APP_URL=http://127.0.0.1:4000
CORS_ORIGINS=http://127.0.0.1:4000

# Local infrastructure
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/restaurant_os
REDIS_URL=redis://127.0.0.1:6379

# Authentication
JWT_ISSUER=restaurant-os-api
JWT_AUDIENCE=restaurant-os
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=restaurant_os_refresh

# Development-only placeholders. Use high-entropy values outside local development.
SESSION_SECRET=change-me-session-secret-change-me-123456
JWT_SECRET=change-me-jwt-secret-change-me-123456
REFRESH_TOKEN_SECRET=change-me-refresh-secret-change-me-123456
PASSWORD_RESET_SECRET=change-me-reset-secret-change-me-123456
APP_ENCRYPTION_KEY=change-me-encryption-key-change-me-123456

# Set only in a development secret store before running db:seed.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Provider integrations are added in their delivery phases.
EVOLUTION_BASE_URL=http://127.0.0.1:8080
EVOLUTION_GLOBAL_API_KEY=change-me
N8N_BASE_URL=http://127.0.0.1:5678
N8N_INBOUND_SECRET=change-me
N8N_CALLBACK_SECRET=change-me
